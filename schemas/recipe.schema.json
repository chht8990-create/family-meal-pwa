{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://homeos.local/schema/recipe.schema.json",
  "title": "HomeOS Recipe",
  "type": "object",
  "required": [
    "id",
    "name",
    "version",
    "status",
    "baseServings",
    "difficulty",
    "time",
    "ingredients",
    "preparation",
    "steps",
    "storage",
    "verification"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^recipe_[a-z0-9_]+$"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string"
    },
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "status": {
      "enum": [
        "draft",
        "active",
        "archived"
      ]
    },
    "baseServings": {
      "type": "number",
      "minimum": 1
    },
    "difficulty": {
      "enum": [
        "easy",
        "normal",
        "hard"
      ]
    },
    "time": {
      "type": "object",
      "required": [
        "prepMinutes",
        "cookMinutes",
        "totalMinutes"
      ],
      "properties": {
        "prepMinutes": {
          "type": "integer",
          "minimum": 0
        },
        "cookMinutes": {
          "type": "integer",
          "minimum": 0
        },
        "restMinutes": {
          "type": "integer",
          "minimum": 0
        },
        "totalMinutes": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "ingredients": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/ingredientLine"
      }
    },
    "preparation": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "order",
          "instruction"
        ],
        "properties": {
          "order": {
            "type": "integer",
            "minimum": 1
          },
          "instruction": {
            "type": "string",
            "minLength": 1
          },
          "minutes": {
            "type": "integer",
            "minimum": 0
          }
        }
      }
    },
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "order",
          "instruction"
        ],
        "properties": {
          "order": {
            "type": "integer",
            "minimum": 1
          },
          "title": {
            "type": "string"
          },
          "instruction": {
            "type": "string",
            "minLength": 1
          },
          "heat": {
            "enum": [
              "none",
              "low",
              "medium_low",
              "medium",
              "medium_high",
              "high"
            ]
          },
          "minutes": {
            "type": "integer",
            "minimum": 0
          },
          "timerRecommended": {
            "type": "boolean"
          },
          "completionCue": {
            "type": "string"
          }
        }
      }
    },
    "tips": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "substitutions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "ingredientId",
          "alternatives"
        ],
        "properties": {
          "ingredientId": {
            "type": "string"
          },
          "alternatives": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "sideDishes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "storage": {
      "type": "object",
      "required": [
        "refrigeratedDays",
        "frozenDays"
      ],
      "properties": {
        "refrigeratedDays": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "frozenDays": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "reheat": {
          "type": "string"
        }
      }
    },
    "metadata": {
      "type": "object",
      "properties": {
        "cuisine": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "mealTypes": {
          "type": "array",
          "items": {
            "enum": [
              "breakfast",
              "lunch",
              "dinner",
              "snack"
            ]
          }
        },
        "tags": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "spiceLevel": {
          "type": "integer",
          "minimum": 0,
          "maximum": 5
        },
        "kidFriendly": {
          "type": "boolean"
        },
        "freezerFriendly": {
          "type": "boolean"
        },
        "weekdayFriendly": {
          "type": "boolean"
        },
        "estimatedCostKrw": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        }
      }
    },
    "verification": {
      "type": "object",
      "required": [
        "level",
        "testedCount"
      ],
      "properties": {
        "level": {
          "enum": [
            "draft",
            "tested_once",
            "tested_multiple",
            "household_verified",
            "official_reviewed"
          ]
        },
        "testedCount": {
          "type": "integer",
          "minimum": 0
        },
        "notes": {
          "type": "string"
        },
        "verifiedAt": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        }
      }
    },
    "revision": {
      "type": "object",
      "properties": {
        "notes": {
          "type": "string"
        },
        "previousVersionId": {
          "type": [
            "string",
            "null"
          ]
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "warnings": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "allergens": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "$defs": {
    "ingredientLine": {
      "type": "object",
      "required": [
        "ingredientId",
        "name",
        "group",
        "quantity",
        "unit",
        "scaling",
        "inventoryTracked",
        "shoppingEligible"
      ],
      "properties": {
        "ingredientId": {
          "type": "string",
          "pattern": "^ingredient_[a-z0-9_]+$"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "group": {
          "enum": [
            "main",
            "seasoning",
            "garnish",
            "optional"
          ]
        },
        "quantity": {
          "type": "number",
          "minimum": 0
        },
        "unit": {
          "enum": [
            "g",
            "kg",
            "ml",
            "l",
            "tsp",
            "tbsp",
            "cup",
            "piece",
            "clove",
            "stalk",
            "slice",
            "pack",
            "bowl",
            "pinch",
            "dash"
          ]
        },
        "quantityText": {
          "type": "string"
        },
        "scaling": {
          "type": "object",
          "required": [
            "mode"
          ],
          "properties": {
            "mode": {
              "enum": [
                "linear",
                "gentle",
                "minimal",
                "fixed",
                "capped",
                "discrete"
              ]
            },
            "minQuantity": {
              "type": "number",
              "minimum": 0
            },
            "maxQuantity": {
              "type": "number",
              "minimum": 0
            },
            "step": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "rounding": {
              "enum": [
                "nearest",
                "up",
                "down"
              ]
            }
          }
        },
        "inventoryTracked": {
          "type": "boolean"
        },
        "shoppingEligible": {
          "type": "boolean"
        },
        "optional": {
          "type": "boolean"
        }
      }
    }
  }
}