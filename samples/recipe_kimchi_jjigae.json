  "preparation": [
    {
      "order": 1,
      "instruction": "김치는 4cm 길이로 자르고 돼지고기는 한입 크기로 썬다.",
      "minutes": 5
    },
    {
      "order": 2,
      "instruction": "두부는 1.5cm 두께로 썰고 대파는 어슷썬다.",
      "minutes": 5
    }
  ],
  "steps": [
    {
      "order": 1,
      "title": "김치와 고기 볶기",
      "instruction": "냄비에 돼지고기를 넣고 중불에서 3분 볶다가 김치를 넣어 5분 더 볶는다.",
      "heat": "medium",
      "minutes": 8,
      "timerRecommended": true,
      "completionCue": "고기 겉면이 익고 김치 숨이 죽는다."
    },
    {
      "order": 2,
      "title": "끓이기",
      "instruction": "물을 붓고 센불에서 끓인다. 끓기 시작하면 고춧가루, 다진 마늘, 국간장을 넣는다.",
      "heat": "high",
      "minutes": 8,
      "timerRecommended": true,
      "completionCue": "국물이 전체적으로 세게 끓는다."
    },
    {
      "order": 3,
      "title": "푹 끓이기",
      "instruction": "중약불로 낮춰 뚜껑을 반쯤 덮고 15분 끓인다.",
      "heat": "medium_low",
      "minutes": 15,
      "timerRecommended": true,
      "completionCue": "김치가 부드러워지고 국물에 붉은 기름이 살짝 돈다."
    },
    {
      "order": 4,
      "title": "두부와 대파 넣기",
      "instruction": "두부와 대파를 넣고 4분 더 끓인다. 간을 보고 부족하면 국간장을 조금 추가한다.",
      "heat": "medium",
      "minutes": 4,
      "timerRecommended": true,
      "completionCue": "두부 중심까지 뜨겁고 대파 숨이 살짝 죽는다."
    }
  ],
  "tips": [
    "김치가 덜 익었다면 식초를 넣기보다 볶는 시간을 2~3분 늘린다.",
    "국물 맛이 약하면 처음부터 소금을 넣지 말고 마지막에 국간장으로 조절한다."
  ],
