  "preparation": [
    {
      "order": 1,
      "instruction": "돼지고기는 키친타월로 가볍게 눌러 겉면의 핏물을 제거한다.",
      "minutes": 3
    },
    {
      "order": 2,
      "instruction": "양파는 1cm 두께로 채 썰고, 당근은 얇게 반달썰기, 대파는 4cm 길이로 썬다.",
      "minutes": 7
    },
    {
      "order": 3,
      "instruction": "고추장, 진간장, 고춧가루, 설탕, 다진 마늘을 섞어 양념장을 만든다.",
      "minutes": 3
    },
    {
      "order": 4,
      "instruction": "고기에 양념장을 버무려 냉장고에서 20분 재운다.",
      "minutes": 20
    }
  ],
  "steps": [
    {
      "order": 1,
      "title": "팬 예열",
      "instruction": "넓은 팬을 강불에서 1분간 충분히 예열한다.",
      "heat": "high",
      "minutes": 1,
      "timerRecommended": true,
      "completionCue": "팬 위로 손을 가까이 댔을 때 열기가 강하게 느껴진다."
    },
    {
      "order": 2,
      "title": "고기 볶기",
      "instruction": "고기를 두 번으로 나눠 팬에 펼쳐 넣고, 처음 1분은 건드리지 않은 뒤 뒤집어가며 볶는다.",
      "heat": "high",
      "minutes": 6,
      "timerRecommended": true,
      "completionCue": "고기 겉면이 대부분 익고 붉은색이 거의 사라진다."
    },
    {
      "order": 3,
      "title": "채소 넣기",
      "instruction": "당근과 양파를 넣고 중강불에서 4분 볶는다. 팬에 물이 많으면 불을 낮추지 않는다.",
      "heat": "medium_high",
      "minutes": 4,
      "timerRecommended": true,
      "completionCue": "양파 가장자리가 투명해지고 당근이 살짝 휘어진다."
    },
    {
      "order": 4,
      "title": "마무리",
      "instruction": "대파를 넣고 2분 볶은 뒤 불을 끄고 참기름과 후추를 넣어 섞는다.",
      "heat": "medium_high",
      "minutes": 2,
      "timerRecommended": true,
      "completionCue": "양념이 고기와 채소에 고르게 묻고 팬 바닥에 물이 거의 남지 않는다."
    }
  ],
  "tips": [
    "6인분은 팬 하나에 전부 넣으면 물이 생기기 쉬우므로 고기를 나눠 볶는다.",
    "참기름은 불을 끈 뒤 넣어야 향이 오래 남는다.",
    "아이와 함께 먹는 경우 고춧가루를 줄이고 양파를 0.5개 늘린다."
  ],
